/* Central manifest of the mirrored, linkable IMAS-Core C ABI.
 *
 * Define IMAS_ABI_SYMBOL(name, expected_function_pointer_type) before
 * including this file. tests/check_exports.cmake also parses these entries,
 * so adding an export without a signature check fails mechanically.
 */
IMAS_ABI_SYMBOL(al_context_info, AbiContextInfoFn)
IMAS_ABI_SYMBOL(al_get_backendID, AbiGetBackendIdFn)
IMAS_ABI_SYMBOL(al_build_uri_from_legacy_parameters, AbiBuildUriFromLegacyParametersFn)
IMAS_ABI_SYMBOL(const2str, AbiStringLookupFn)
IMAS_ABI_SYMBOL(err2str, AbiStringLookupFn)
IMAS_ABI_SYMBOL(getALVersion, AbiVersionAccessorFn)
IMAS_ABI_SYMBOL(getDDVersion, AbiVersionAccessorFn)
IMAS_ABI_SYMBOL(al_begin_dataentry_action, AbiBeginDataentryActionFn)
IMAS_ABI_SYMBOL(al_close_pulse, AbiClosePulseFn)
IMAS_ABI_SYMBOL(al_begin_global_action, AbiBeginGlobalActionFn)
IMAS_ABI_SYMBOL(al_begin_slice_action, AbiBeginSliceActionFn)
IMAS_ABI_SYMBOL(al_begin_timerange_action, AbiBeginTimerangeActionFn)
IMAS_ABI_SYMBOL(al_begin_arraystruct_action, AbiBeginArraystructActionFn)
IMAS_ABI_SYMBOL(al_end_action, AbiEndActionFn)
IMAS_ABI_SYMBOL(al_read_data, AbiReadDataFn)
IMAS_ABI_SYMBOL(al_write_data, AbiWriteDataFn)
IMAS_ABI_SYMBOL(al_delete_data, AbiDeleteDataFn)
IMAS_ABI_SYMBOL(al_iterate_over_arraystruct, AbiIterateOverArraystructFn)
IMAS_ABI_SYMBOL(al_get_occurrences, AbiGetOccurrencesFn)
IMAS_ABI_SYMBOL(al_list_filled_paths, AbiListFilledPathsFn)
IMAS_ABI_SYMBOL(al_register_plugin, AbiPluginNameFn)
IMAS_ABI_SYMBOL(al_unregister_plugin, AbiPluginNameFn)
