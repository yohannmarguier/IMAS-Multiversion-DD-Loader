IMAS_ABI_SYMBOL(al_unbind_plugin, AbiBindPluginFn)
IMAS_ABI_SYMBOL(al_bind_readback_plugins, AbiPluginContextFn)
IMAS_ABI_SYMBOL(al_unbind_readback_plugins, AbiPluginContextFn)
IMAS_ABI_SYMBOL(al_is_plugin_registered, AbiIsPluginRegisteredFn)
IMAS_ABI_SYMBOL(al_write_plugins_metadata, AbiPluginContextFn)
IMAS_ABI_SYMBOL(al_setvalue_parameter_plugin, AbiSetvalueParameterPluginFn)
