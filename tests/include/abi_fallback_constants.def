/* Fallback id/name pairs src/resolve.rs hand-transcribes from IMAS-Core's
 * al_defs.h (the numeric ids) and al_const.h's constmap/errmap (the
 * strings), answered on the version-mismatch path where the shim cannot
 * safely resolve further symbols from the mismatched library.
 *
 * Define IMAS_ABI_FALLBACK_CONST(macro_name, expected_value, expected_string)
 * and IMAS_ABI_FALLBACK_ERR(macro_name, expected_value, expected_string)
 * before including this file. UNDEFINED_TIME is deliberately absent: it is
 * a floating-point macro and needs its own non-integer-constant-expression
 * check, done separately in real_core_abi_core_check.c.
 */
IMAS_ABI_FALLBACK_CONST(NO_BACKEND, 10, "NO_BACKEND")
IMAS_ABI_FALLBACK_CONST(ASCII_BACKEND, 11, "ASCII_BACKEND")
IMAS_ABI_FALLBACK_CONST(MDSPLUS_BACKEND, 12, "MDSPLUS_BACKEND")
IMAS_ABI_FALLBACK_CONST(HDF5_BACKEND, 13, "HDF5_BACKEND")
IMAS_ABI_FALLBACK_CONST(MEMORY_BACKEND, 14, "MEMORY_BACKEND")
IMAS_ABI_FALLBACK_CONST(UDA_BACKEND, 15, "UDA_BACKEND")
IMAS_ABI_FALLBACK_CONST(GLOBAL_OP, 20, "GLOBAL_OP")
IMAS_ABI_FALLBACK_CONST(SLICE_OP, 21, "SLICE_OP")
IMAS_ABI_FALLBACK_CONST(READ_OP, 30, "READ_OP")
IMAS_ABI_FALLBACK_CONST(WRITE_OP, 31, "WRITE_OP")
IMAS_ABI_FALLBACK_CONST(REPLACE_OP, 32, "REPLACE_OP")
IMAS_ABI_FALLBACK_CONST(UNDEFINED_INTERP, 0, "UNDEFINED_INTERP")
IMAS_ABI_FALLBACK_CONST(CLOSEST_INTERP, 1, "CLOSEST_INTERP")
IMAS_ABI_FALLBACK_CONST(PREVIOUS_INTERP, 2, "PREVIOUS_INTERP")
IMAS_ABI_FALLBACK_CONST(LINEAR_INTERP, 3, "LINEAR_INTERP")
IMAS_ABI_FALLBACK_CONST(OPEN_PULSE, 40, "OPEN_PULSE")
IMAS_ABI_FALLBACK_CONST(FORCE_OPEN_PULSE, 41, "FORCE_OPEN_PULSE")
IMAS_ABI_FALLBACK_CONST(CREATE_PULSE, 42, "CREATE_PULSE")
IMAS_ABI_FALLBACK_CONST(FORCE_CREATE_PULSE, 43, "FORCE_CREATE_PULSE")
IMAS_ABI_FALLBACK_CONST(CLOSE_PULSE, 44, "CLOSE_PULSE")
IMAS_ABI_FALLBACK_CONST(ERASE_PULSE, 45, "ERASE_PULSE")
IMAS_ABI_FALLBACK_CONST(CHAR_DATA, 50, "CHAR_DATA")
IMAS_ABI_FALLBACK_CONST(INTEGER_DATA, 51, "INTEGER_DATA")
IMAS_ABI_FALLBACK_CONST(DOUBLE_DATA, 52, "DOUBLE_DATA")
IMAS_ABI_FALLBACK_CONST(COMPLEX_DATA, 53, "COMPLEX_DATA")
IMAS_ABI_FALLBACK_CONST(ASCII_SERIALIZER_PROTOCOL, 60, "ASCII_SERIALIZER_PROTOCOL")
IMAS_ABI_FALLBACK_CONST(FLEXBUFFERS_SERIALIZER_PROTOCOL, 61, "FLEXBUFFERS_SERIALIZER_PROTOCOL")
IMAS_ABI_FALLBACK_ERR(UNKNOWN_ERR, -1, "UNKNOWN_ERR")
IMAS_ABI_FALLBACK_ERR(CONTEXT_ERR, -2, "CONTEXT_ERR")
IMAS_ABI_FALLBACK_ERR(BACKEND_ERR, -3, "BACKEND_ERR")
IMAS_ABI_FALLBACK_ERR(LOWLEVEL_ERR, -4, "LOWLEVEL_ERR")
