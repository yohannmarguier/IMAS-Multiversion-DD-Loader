<?xml version="1.0" encoding="UTF-8"?>
<!--
  equilibrium: DD 3.39.0 <-> DD 4.1.1

  Derived from the imas-dd MCP server path sets for both versions:
    563 paths on the left, 455 on the right
    377 identical, 186 left-only, 78 right-only

  Nine paths were removed from the 3.39.0 inventory and declared right_only
  here, all confirmed via the imas-dd version history to have been added to
  the DD in 3.40.0 or 3.41.0 - after 3.39.0, so the transcribed 3.39.0
  inventory listing them was wrong, not merely incomplete like the ~12%
  under-report the README documents: q_min/psi, q_min/psi_norm,
  constraints/j_parallel (a 13-path subtree), constraints/chi_squared_reduced,
  constraints/freedom_degrees_n, constraints/constraints_n,
  global_quantities/rho_tor_boundary, profiles_1d/psi_norm and
  convergence/result (a 2-path subtree, 3.41.0). eq_convert_3to4.f90 had
  already independently discovered and hand-refused every one of these as
  "missing from map" before the map itself was fixed to agree.

  Rules below claim every left-only and right-only path. Paths present in both
  and unclaimed fall through to <default rel="identical"/>. That default is
  deliberate, and it is what the completeness proof's scope rests on: with it
  present, no inventory path can be *unclaimed*, so the load-bearing assertion
  is the other one - a default-claimed path must genuinely exist by the same
  spelling on the other side (ConversionMap::check_completeness).

  Both inventories carry one path the imas-dd MCP path sets do not enumerate:
  ids_properties/version_put/data_dictionary, confirmed present as STR_0D in
  both 3.39.0 and 4.1.1. That enumeration excludes the ids_properties/** and
  code/** metadata subtrees wholesale, so the inventories are the DD *data*
  surface - except for this one path, which the shim itself reads at every
  open to discover the stored DD version (ADR 0007), and which therefore has
  to be inside the proof rather than outside it. The rest of those two
  subtrees remains outside the proof's scope, stated in README.md.

  Rules marked decision="yes" encode a judgement that is NOT derivable from the
  DD and should be reviewed by a physicist. Run validate.py to list them.
-->
<ids-map ids="equilibrium" format-version="1">

  <side id="left"  dd="3.39.0" cocos="11" inventory="../inventory/equilibrium-3.39.0.txt"/>
  <side id="right" dd="4.1.1"  cocos="17" inventory="../inventory/equilibrium-4.1.1.txt"/>

  <include href="../common/error-model-3to4.xml"/>
  <include href="../common/naming-3to4.xml"/>

  <default rel="identical"/>

  <!-- Generated by "validate.py TARGET .write-coverage". Do not hand-edit. -->
  <coverage scope="/" forward="unmappable" reverse="unmappable"/>
  <coverage scope="grids_ggd" forward="exact" reverse="exact"/>
  <coverage scope="grids_ggd/grid" forward="exact" reverse="exact"/>
  <coverage scope="time" forward="exact" reverse="exact"/>
  <coverage scope="time_slice" forward="unmappable" reverse="unmappable"/>
  <coverage scope="time_slice/boundary" forward="unmappable" reverse="unmappable"/>
  <coverage scope="time_slice/boundary_secondary_separatrix" forward="lossy" reverse="unmappable"/>
  <coverage scope="time_slice/boundary_separatrix" forward="lossy" reverse="unmappable"/>
  <coverage scope="time_slice/constraints" forward="unmappable" reverse="unmappable"/>
  <coverage scope="time_slice/contour_tree" forward="unmappable" reverse="lossy"/>
  <coverage scope="time_slice/convergence" forward="unmappable" reverse="lossy"/>
  <coverage scope="time_slice/coordinate_system" forward="lossy" reverse="unmappable"/>
  <coverage scope="time_slice/ggd" forward="lossy" reverse="unmappable"/>
  <coverage scope="time_slice/global_quantities" forward="unmappable" reverse="lossy"/>
  <coverage scope="time_slice/profiles_1d" forward="unmappable" reverse="lossy"/>
  <coverage scope="time_slice/profiles_2d" forward="lossy" reverse="exact"/>
  <coverage scope="vacuum_toroidal_field" forward="exact" reverse="exact"/>

  <rules>

    <!-- ================================================================
         1. Obsolescent DD3 aliases folded into their modern counterpart.

         3.39.0 ships both names; 4.1.1 keeps only the modern one. Two left
         paths therefore land on one right path. Forward is lossy because if
         both are populated and disagree, one value is discarded. Reverse
         writes only the modern name and leaves the obsolescent alias empty,
         which is what the DD3 lifecycle status already asks for.
         ================================================================ -->

    <rule id="fold-constraints-j" rel="merged"
          right="time_slice/constraints/j_phi" subtree="yes" source="derived">
      <from left="time_slice/constraints/j_phi" precedence="1"/>
      <from left="time_slice/constraints/j_tor" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"
                reason="both DD3 names may hold different values"/>
    </rule>

    <rule id="fold-ggd-j" rel="merged"
          right="time_slice/ggd/j_phi" subtree="yes" source="derived">
      <from left="time_slice/ggd/j_phi" precedence="1"/>
      <from left="time_slice/ggd/j_tor" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-ggd-bfield" rel="merged"
          right="time_slice/ggd/b_field_phi" subtree="yes" source="derived">
      <from left="time_slice/ggd/b_field_phi" precedence="1"/>
      <from left="time_slice/ggd/b_field_tor" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p1d-j" rel="merged"
          right="time_slice/profiles_1d/j_phi" source="derived">
      <from left="time_slice/profiles_1d/j_phi" precedence="1"/>
      <from left="time_slice/profiles_1d/j_tor" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p2d-j" rel="merged"
          right="time_slice/profiles_2d/j_phi" source="derived">
      <from left="time_slice/profiles_2d/j_phi" precedence="1"/>
      <from left="time_slice/profiles_2d/j_tor" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <!-- Three-way: profiles_2d carries b_tor (oldest), b_field_tor, and
         b_field_phi in 3.39.0. Only b_field_phi survives. -->
    <rule id="fold-p2d-bphi" rel="merged"
          right="time_slice/profiles_2d/b_field_phi" source="derived">
      <from left="time_slice/profiles_2d/b_field_phi" precedence="1"/>
      <from left="time_slice/profiles_2d/b_field_tor" precedence="2" deprecated="yes"/>
      <from left="time_slice/profiles_2d/b_tor" precedence="3" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"
                reason="three DD3 spellings collapse to one DD4 path"/>
    </rule>

    <rule id="fold-p2d-br" rel="merged"
          right="time_slice/profiles_2d/b_field_r" source="derived">
      <from left="time_slice/profiles_2d/b_field_r" precedence="1"/>
      <from left="time_slice/profiles_2d/b_r" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p2d-bz" rel="merged"
          right="time_slice/profiles_2d/b_field_z" source="derived">
      <from left="time_slice/profiles_2d/b_field_z" precedence="1"/>
      <from left="time_slice/profiles_2d/b_z" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <!-- Three-way again on the magnetic axis. -->
    <rule id="fold-axis-bphi" rel="merged"
          right="time_slice/global_quantities/magnetic_axis/b_field_phi" source="derived">
      <from left="time_slice/global_quantities/magnetic_axis/b_field_phi" precedence="1"/>
      <from left="time_slice/global_quantities/magnetic_axis/b_field_tor" precedence="2" deprecated="yes"/>
      <from left="time_slice/global_quantities/magnetic_axis/b_tor" precedence="3" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p1d-baverage" rel="merged"
          right="time_slice/profiles_1d/b_field_average" source="derived">
      <from left="time_slice/profiles_1d/b_field_average" precedence="1"/>
      <from left="time_slice/profiles_1d/b_average" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p1d-bmax" rel="merged"
          right="time_slice/profiles_1d/b_field_max" source="derived">
      <from left="time_slice/profiles_1d/b_field_max" precedence="1"/>
      <from left="time_slice/profiles_1d/b_max" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-p1d-bmin" rel="merged"
          right="time_slice/profiles_1d/b_field_min" source="derived">
      <from left="time_slice/profiles_1d/b_field_min" precedence="1"/>
      <from left="time_slice/profiles_1d/b_min" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <rule id="fold-energy-mhd" rel="merged"
          right="time_slice/global_quantities/energy_mhd" source="derived">
      <from left="time_slice/global_quantities/energy_mhd" precedence="1"/>
      <from left="time_slice/global_quantities/w_mhd" precedence="2" deprecated="yes"/>
      <fidelity forward="lossy" reverse="exact"/>
    </rule>

    <!-- ================================================================
         2. True renames: the DD3 name is the only name on the left.
         ================================================================ -->

    <rule id="rename-beta-normal" rel="renamed"
          left="time_slice/global_quantities/beta_normal"
          right="time_slice/global_quantities/beta_tor_norm" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <!-- ================================================================
         3. Container-shape change.

         DD3 stored a flat INT_1D list of coordinate-type codes. DD4 stores an
         array of identifier structures whose only child is `index`, holding
         the same integers. Shape-only, so exactly reversible both ways.
         ================================================================ -->

    <rule id="retype-coordinates-type" rel="retyped"
          left="grids_ggd/grid/space/coordinates_type"
          right="grids_ggd/grid/space/coordinates_type"
          subtree="yes" shape="int_1d:struct_array" key="index" source="mcp">
      <fidelity forward="exact" reverse="exact"
                reason="integers preserved; only the container changes"/>
    </rule>

    <!-- ================================================================
         4. Structural relocation: DD4's `boundary` absorbed part of DD3's
            `boundary_separatrix`.

            In DD3, `boundary`, `boundary_separatrix` and
            `boundary_secondary_separatrix` are three sibling structures. DD4
            keeps only `boundary`, and it gained closest_wall_point,
            dr_dz_zero_point and gap — all of which lived under
            boundary_separatrix in DD3.
         ================================================================ -->

    <rule id="move-closest-wall-point" rel="moved"
          left="time_slice/boundary_separatrix/closest_wall_point"
          right="time_slice/boundary/closest_wall_point"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <rule id="move-dr-dz-zero-point" rel="moved"
          left="time_slice/boundary_separatrix/dr_dz_zero_point"
          right="time_slice/boundary/dr_dz_zero_point"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <rule id="move-gap" rel="moved"
          left="time_slice/boundary_separatrix/gap"
          right="time_slice/boundary/gap"
          subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="exact"
                reason="gap/identifier has no DD4 counterpart; see drop-gap-identifier"/>
    </rule>

    <!-- More specific than move-gap, so it wins by longest-match. -->
    <rule id="drop-gap-identifier" rel="left_only"
          left="time_slice/boundary_separatrix/gap/identifier"
          subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>

    <!-- ================================================================
         5. DD3-only, no DD4 equivalent.
         ================================================================ -->

    <!-- Obsolescent already in 3.39.0 -->
    <rule id="drop-lcfs" rel="left_only"
          left="time_slice/boundary/lcfs" subtree="yes" source="derived"
          reason="obsolescent_in_dd3">
      <fidelity forward="lossy" reverse="unmappable"/>
      <note>Marked obsolescent in 3.39.0; DD4 removed it. The LCFS outline is
            carried by boundary/outline in DD4.</note>
    </rule>

    <rule id="drop-b-flux-pol-norm" rel="left_only"
          left="time_slice/boundary/b_flux_pol_norm" source="derived"
          reason="obsolescent_in_dd3">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>

    <!-- The twelve explicit g_ij metric components were obsolescent in 3.39.0.
         DD4 carries the metric via tensor_covariant / tensor_contravariant,
         which are identical on both sides. Listed one per rule so each is
         visible to a reviewer rather than hidden behind a wildcard. -->
    <rule id="drop-g11-cov" rel="left_only" left="time_slice/coordinate_system/g11_covariant" source="derived"
          reason="obsolescent_in_dd3">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g11-contra" rel="left_only" left="time_slice/coordinate_system/g11_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g12-cov" rel="left_only" left="time_slice/coordinate_system/g12_covariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g12-contra" rel="left_only" left="time_slice/coordinate_system/g12_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g13-cov" rel="left_only" left="time_slice/coordinate_system/g13_covariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g13-contra" rel="left_only" left="time_slice/coordinate_system/g13_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g22-cov" rel="left_only" left="time_slice/coordinate_system/g22_covariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g22-contra" rel="left_only" left="time_slice/coordinate_system/g22_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g23-cov" rel="left_only" left="time_slice/coordinate_system/g23_covariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g23-contra" rel="left_only" left="time_slice/coordinate_system/g23_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g33-cov" rel="left_only" left="time_slice/coordinate_system/g33_covariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-g33-contra" rel="left_only" left="time_slice/coordinate_system/g33_contravariant" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>

    <!-- DD3 embedded a full GGD grid description inside each time slice. DD4
         removed it; grids_ggd at IDS level is the single grid container, and
         ggd/*/grid_index references it. -->
    <rule id="drop-timeslice-ggd-grid" rel="left_only"
          left="time_slice/ggd/grid" subtree="yes" source="derived"
          reason="obsolescent_in_dd3">
      <fidelity forward="lossy" reverse="unmappable"/>
      <note>37 paths. DD4 references grids_ggd via ggd/*/grid_index instead of
            embedding a per-slice grid copy.</note>
    </rule>

    <!-- boundary: point geometry dropped from the DD4 boundary structure -->
    <rule id="drop-boundary-active-limiter" rel="left_only"
          left="time_slice/boundary/active_limiter_point" subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-boundary-strike-point" rel="left_only"
          left="time_slice/boundary/strike_point" subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
      <note>Not the same quantity as constraints/strike_point, which is a
            reconstruction constraint and exists on both sides.</note>
    </rule>
    <rule id="drop-boundary-x-point" rel="left_only"
          left="time_slice/boundary/x_point" subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-boundary-elongation-lower" rel="left_only"
          left="time_slice/boundary/elongation_lower" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>
    <rule id="drop-boundary-elongation-upper" rel="left_only"
          left="time_slice/boundary/elongation_upper" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
    </rule>

    <!-- Whole DD3 sibling structures removed by DD4. The subtree rules below
         claim everything not already taken by the three `moved` rules above,
         which are more specific and therefore win. -->
    <rule id="drop-boundary-separatrix" rel="left_only"
          left="time_slice/boundary_separatrix" subtree="yes" source="derived"
          decision="yes">
      <fidelity forward="lossy" reverse="unmappable"/>
      <note>DECISION. DD4's `boundary` is arguably the separatrix now: it
            absorbed closest_wall_point, dr_dz_zero_point and gap from this
            structure. The remaining ~30 quantities here (elongation,
            triangularity_*, squareness_*, outline, psi, geometric_axis,
            minor_radius, type, strike_point, x_point, active_limiter_point)
            duplicate names that DD4 keeps under `boundary`, which this map
            currently maps identically from DD3's own `boundary`. If the
            separatrix values are the ones that should survive, these should
            become `moved` rules into boundary/* and the identical mappings
            from DD3 boundary/* should be demoted. Needs a physicist.</note>
    </rule>

    <rule id="drop-boundary-secondary-separatrix" rel="left_only"
          left="time_slice/boundary_secondary_separatrix" subtree="yes" source="derived">
      <fidelity forward="lossy" reverse="unmappable"/>
      <note>12 paths. DD4 has no secondary-separatrix container at all.</note>
    </rule>

    <!-- ================================================================
         6. DD4-only: nothing on the left to build these from.
         ================================================================ -->

    <rule id="new-contour-tree" rel="right_only"
          right="time_slice/contour_tree" subtree="yes" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="new DD4 structure; no DD3 source"/>
      <note>10 paths. Critical-point/level-set topology of psi, new in DD4.</note>
    </rule>

    <rule id="new-boundary-phi" rel="right_only"
          right="time_slice/boundary/phi" source="derived">
      <fidelity forward="unmappable" reverse="lossy"/>
    </rule>

    <rule id="new-boundary-rho-tor" rel="right_only"
          right="time_slice/boundary/rho_tor" source="derived">
      <fidelity forward="unmappable" reverse="lossy"/>
    </rule>

    <rule id="new-boundary-phi-poloidal-current" rel="right_only"
          right="time_slice/boundary/phi_poloidal_current" source="derived">
      <fidelity forward="unmappable" reverse="lossy"/>
    </rule>

    <rule id="new-q-min-psi" rel="right_only"
          right="time_slice/global_quantities/q_min/psi" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-q-min-psi-norm" rel="right_only"
          right="time_slice/global_quantities/q_min/psi_norm" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-constraints-j-parallel" rel="right_only"
          right="time_slice/constraints/j_parallel" subtree="yes" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
      <note>13 paths. DD3 constraints has no j_parallel entry at all, only
            j_phi/j_tor.</note>
    </rule>

    <rule id="new-constraints-chi-squared-reduced" rel="right_only"
          right="time_slice/constraints/chi_squared_reduced" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-constraints-freedom-degrees-n" rel="right_only"
          right="time_slice/constraints/freedom_degrees_n" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-constraints-constraints-n" rel="right_only"
          right="time_slice/constraints/constraints_n" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-global-quantities-rho-tor-boundary" rel="right_only"
          right="time_slice/global_quantities/rho_tor_boundary" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-profiles-1d-psi-norm" rel="right_only"
          right="time_slice/profiles_1d/psi_norm" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.40.0; no counterpart in 3.39.0"/>
    </rule>

    <rule id="new-convergence-result" rel="right_only"
          right="time_slice/convergence/result" subtree="yes" source="derived">
      <fidelity forward="unmappable" reverse="lossy"
                reason="path added in DD 3.41.0; no counterpart in 3.39.0"/>
      <note>2 paths (result, result/index).</note>
    </rule>

    <!-- psi_axis survives into DD4 but DD4 also introduces the clearer
         psi_magnetic_axis for the same quantity. Feeding both keeps the
         forward conversion complete. -->
    <rule id="split-psi-axis" rel="split"
          left="time_slice/global_quantities/psi_axis" source="manual"
          decision="yes">
      <from right="time_slice/global_quantities/psi_axis" precedence="1"/>
      <from right="time_slice/global_quantities/psi_magnetic_axis" precedence="2"/>
      <fidelity forward="exact" reverse="exact"/>
      <note>DECISION. Assumes psi_magnetic_axis is the same quantity as
            psi_axis (poloidal flux at the magnetic axis), so the DD3 value is
            written to both DD4 paths. If they are not interchangeable, change
            this to right_only on psi_magnetic_axis and let psi_axis map
            identically. Both targets take the COCOS sign flip.</note>
    </rule>

    <!-- ================================================================
         7. True renames found by the issue #50 completeness proof: every
         path under these four subtrees fell through to <default
         rel="identical"/> on both sides even though the container itself was
         renamed at DD4's 4.0.0 boundary, so no path was actually identical.
         Confirmed via the imas-dd version history (each old spelling
         path_removed and each new spelling path_added at the same 4.0.0
         step) rather than assumed from name similarity.
         ================================================================ -->

    <rule id="rename-bpol-probe" rel="renamed"
          left="time_slice/constraints/bpol_probe"
          right="time_slice/constraints/b_field_pol_probe"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <rule id="rename-mse-polarisation-angle" rel="renamed"
          left="time_slice/constraints/mse_polarisation_angle"
          right="time_slice/constraints/mse_polarization_angle"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <rule id="rename-magnetisation-r" rel="renamed"
          left="time_slice/constraints/iron_core_segment/magnetisation_r"
          right="time_slice/constraints/iron_core_segment/magnetization_r"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

    <rule id="rename-magnetisation-z" rel="renamed"
          left="time_slice/constraints/iron_core_segment/magnetisation_z"
          right="time_slice/constraints/iron_core_segment/magnetization_z"
          subtree="yes" source="derived">
      <fidelity forward="exact" reverse="exact"/>
    </rule>

  </rules>

  <!-- ================================================================
       Value transforms, keyed on the RIGHT path so they never compete with a
       structural rule for ownership of a path.
       ================================================================ -->
  <transforms>

    <!--
      COCOS 11 -> 17. Multiplying by -1 flips only the IEEE-754 sign bit, so
      these are exactly invertible and need no direction-specific handling.

      Sourced from the imas-dd migration guide. The guide also lists
      constraints/j_tor/position/psi; that is the obsolescent DD3 alias of
      constraints/j_phi/position/psi and is deliberately absent here, since
      transforms apply to the right-side path after the fold-constraints-j
      merge has run. Listing both would flip the same value twice.
    -->
    <cocos from="11" to="17">
      <flip path="time_slice/boundary/psi"/>
      <flip path="time_slice/constraints/flux_loop/measured"/>
      <flip path="time_slice/constraints/flux_loop/reconstructed"/>
      <flip path="time_slice/constraints/ip/measured"/>
      <flip path="time_slice/constraints/ip/reconstructed"/>
      <flip path="time_slice/constraints/j_phi/position/psi"/>
      <flip path="time_slice/constraints/n_e/position/psi"/>
