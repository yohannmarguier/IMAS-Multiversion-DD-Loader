    <!--
      The imas-dd guide reports these as "unit changes", but m -> m^-2 is a
      dimensional redefinition, not a rescale: chi-squared is now normalised by
      the measurement variance. No factor inverts it without the variance used
      at reconstruction time, so the engine must refuse rather than guess.
    -->
    <redefine glob="time_slice/constraints/strike_point/chi_squared_r"
              left-units="m" right-units="m^-2">
      <fidelity forward="unmappable" reverse="unmappable"
                reason="variance_not_recoverable"/>
    </redefine>
    <redefine glob="time_slice/constraints/strike_point/chi_squared_z"
              left-units="m" right-units="m^-2">
      <fidelity forward="unmappable" reverse="unmappable"
                reason="variance_not_recoverable"/>
    </redefine>
    <redefine glob="time_slice/constraints/x_point/chi_squared_r"
              left-units="m" right-units="m^-2">
      <fidelity forward="unmappable" reverse="unmappable"
                reason="variance_not_recoverable"/>
    </redefine>
    <redefine glob="time_slice/constraints/x_point/chi_squared_z"
              left-units="m" right-units="m^-2">
      <fidelity forward="unmappable" reverse="unmappable"
                reason="variance_not_recoverable"/>
    </redefine>

    <!--
      profiles_1d/psi and profiles_2d/psi also appear in the imas-dd output as
      `definition_change (sign_convention)` in addition to `cocos_sign_flip`.
      That is the same physical fact reported twice. They are listed once, in
      the <cocos> block above; the XSD uniqueness constraint on flip/@path and
      validate.py's overlap check both guard against reintroducing a duplicate.
    -->

